<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <!-- A dim glass base, not a white wash: over a bright poster white-on-white disappears. -->
            <gradient android:angle="270" android:startColor="#47000000" android:endColor="#17000000" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
