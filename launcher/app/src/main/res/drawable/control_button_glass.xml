<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted square that wraps the control-centre glyph while it has focus. iOS glass reads as a
     translucent white pane with a bright hairline rim, brightest at the top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:startColor="#4DFFFFFF"
        android:centerColor="#24FFFFFF"
        android:endColor="#12FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
</shape>
