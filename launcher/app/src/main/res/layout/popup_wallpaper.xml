<?xml version="1.0" encoding="utf-8"?>
<!--
  The Desktop settings panel, in three groups: what is behind the desk, how the desk is laid out,
  and the TV's own settings. Same glass sheet and focus-pill rows as the other menus.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/liquid_glass_panel"
    android:padding="6dp"
    android:scrollbars="none"
    android:focusable="false"
    android:descendantFocusability="afterDescendants"
    android:elevation="12dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Names the sub-page: 壁纸 / 桌面 / 电视, picked from the 桌面设置 hub. -->
    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:textColor="#E6111114"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 600" />

    <!-- The Bing daily picture: fetched on its own, so it shows a tick. -->
    <LinearLayout
        android:id="@+id/rowBing"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bing_daily"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/bingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:id="@+id/bingTick"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tick"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- The daily clip. One tap turns it on: it changes every morning on its own. -->
    <LinearLayout
        android:id="@+id/rowLoop"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loop_wallpaper"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/loopStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:id="@+id/loopTick"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tick"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Which clip, or the daily rotation. Shown only while the wallpaper is on. -->
    <LinearLayout
        android:id="@+id/rowLoopPick"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loop_pick_title"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/loopPickStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Pick a picture the user already has on the TV. -->
    <LinearLayout
        android:id="@+id/rowPick"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pick_wallpaper"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Remove the picture and go back to the plain background. -->
    <LinearLayout
        android:id="@+id/rowOff"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wallpaper_off"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Where the weather comes from: IP by default, or a picked city. -->
    <LinearLayout
        android:id="@+id/rowCity"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weather_city"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/cityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- How many days the top bar lays out. -->
    <LinearLayout
        android:id="@+id/rowForecast"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forecast_days"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/forecastStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Icons per row; the value is written out underneath. -->
    <LinearLayout
        android:id="@+id/rowColumns"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/columns_title"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/columnsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- The dock sizes itself from this. -->
    <LinearLayout
        android:id="@+id/rowDockSize"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dock_size_title"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/dockSizeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Whether Menu also opens quick settings over another app. -->
    <LinearLayout
        android:id="@+id/rowMenuKey"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_key_everywhere"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/menuKeyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- The animation-rate control lives on the 帧率 page now. -->

    <!-- Follow the TV, or force 24- / 12-hour. -->
    <LinearLayout
        android:id="@+id/rowClock"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clock_format"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/clockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- The desk's own focus thud. The firmware's key click is not ours to silence. -->
    <LinearLayout
        android:id="@+id/rowFocusSound"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/focus_sound"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/focusSoundStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- The TV's own settings, in the same panel as the desk's. -->
    <LinearLayout
        android:id="@+id/rowTvNetwork"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quick_network"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!--  -->
    <LinearLayout
        android:id="@+id/rowTvPicture"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quick_picture"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!--  -->
    <LinearLayout
        android:id="@+id/rowTvApps"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quick_apps"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!--  -->
    <LinearLayout
        android:id="@+id/rowTvSystem"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tv_settings"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- The way back: uninstalling restores the stock launcher. -->
    <LinearLayout
        android:id="@+id/rowRestore"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restore_stock"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/restoreHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
