<?xml version="1.0" encoding="utf-8"?>
<!--
  The weather city picker: one glass list that first shows provinces, then the cities in the
  chosen province. Back (or the first row) goes up a level. Height is set from the content when
  the popup is built, so a long list scrolls inside the panel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="6dp"
    android:elevation="12dp">

    <TextView
        android:id="@+id/cityTitle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:letterSpacing="0.12" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cityRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:scrollbars="none" />
</LinearLayout>
