<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Wallpaper, then the focused video app's poster, with readability scrims. -->
    <com.gathin.tvhome.WallpaperStage
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="68dp"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:singleLine="true" />

    <!-- Title of the show whose poster is on screen. Positioned in code just above the app name;
         the dot strip lives separately, above the dock. -->
    <LinearLayout
        android:id="@+id/programBar"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="68dp"
        android:layout_marginStart="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0"
        android:visibility="gone"
        android:focusable="false"
        android:descendantFocusability="afterDescendants">

        <TextView
            android:id="@+id/programTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#E6FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.01"
            android:includeFontPadding="false"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6" />
    </LinearLayout>

    <!-- One dot per hot poster for the focused app; positioned in code just above the dock. -->
    <LinearLayout
        android:id="@+id/programDots"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0"
        android:visibility="gone"
        android:focusable="false"
        android:descendantFocusability="afterDescendants" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="56dp"
        android:paddingStart="56dp"
        android:paddingRight="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Full width, with the right 200dp left empty for the capsule. Do not go back to
                 wrap_content here: the clock row below is match_parent, and a match_parent child
                 inside a wrap_content parent is circular. Some ROMs (seen on Android 6 4A) resolve
                 it as row width = padding only, so every clock/date glyph wraps on its own line in
                 a zero-width column: invisible, ~320dp tall, and it drags the capsule (aligned to
                 this block's bottom) halfway down the screen. -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:orientation="vertical"
                android:paddingRight="200dp"
                android:paddingEnd="200dp">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#73000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <!-- The 200dp capsule gap lives on leftBlock, so the weather line also
                     ellipsizes before it can slide under the buttons. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="7" />

                    <TextView
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:shadowColor="#73000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginLeft="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:shadowColor="#73000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true" />

                    <!-- Local weather, located by IP; gone until there is a reading. -->
                    <LinearLayout
                        android:id="@+id/weatherRow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="bottom"
                        android:layout_marginLeft="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="7dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:focusable="false">

                        <ImageView
                            android:id="@+id/weatherIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:tint="#E6FFFFFF"
                            android:contentDescription="@null" />

                        <!-- One line: the city, today, then tomorrow / the day after when asked for. -->
                        <TextView
                            android:id="@+id/weatherText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginStart="8dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#F2FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:includeFontPadding="false"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="6" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:padding="3dp">

                <!-- Wi-Fi keeps its own pill to the left: the sheet behind it lists the networks
                     around, which is a different job from the control panel. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <View
                        android:id="@+id/wifiGlass"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/control_button_glass"
                        android:alpha="0" />

                    <ImageView
                        android:id="@+id/btnWifi"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@null"
                        android:padding="11dp"
                        android:src="@drawable/ic_wifi"
                        android:scaleType="fitCenter"
                        android:focusable="true"
                        android:clickable="true"
                        android:contentDescription="@string/network"
                        android:nextFocusLeft="@id/btnWifi"
                        android:nextFocusRight="@id/btnControl"
                        android:nextFocusUp="@id/btnWifi"
                        android:nextFocusDown="@+id/grid" />
                </FrameLayout>

                <!-- One glass entry, like the tvOS control pill: everything (wallpaper, dock,
                     sources) lives in the panel it opens. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!-- The frosted square appears only on focus; the glyph itself stays bare. -->
                    <View
                        android:id="@+id/controlGlass"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/control_button_glass"
                        android:alpha="0" />

                    <!-- Bare iOS toggle glyph: no tile, no text. An ImageView, not a TextView with
                         drawableLeft: a compound drawable hangs off the text's left edge and sits
                         off-centre inside the frosted square. -->
                    <ImageView
                        android:id="@+id/btnControl"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_control_ios"
                        android:scaleType="fitCenter"
                        android:focusable="true"
                        android:clickable="true"
                        android:contentDescription="@string/control_center"
                        android:nextFocusLeft="@id/btnWifi"
                        android:nextFocusRight="@id/btnControl"
                        android:nextFocusUp="@id/btnControl"
                        android:nextFocusDown="@+id/grid" />

                    <!-- Unread update badge. A dot, not a number: there is only ever one update. -->
                    <View
                        android:id="@+id/updateDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/dot_unread"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:focusable="false"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- A black desk with no tiles is indistinguishable from a crash; say why it is empty. -->
    <TextView
        android:id="@+id/emptyHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0.65"
        android:visibility="gone"
        android:focusable="false"
        android:text="@string/no_apps"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/outfit" />

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Update notice: a one-line message under the control icon. Positioned in code from the
         icon's rect, hidden unless an unread update was found. -->
    <TextView
        android:id="@+id/updateBanner"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginRight="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/update_notice_bg"
        android:paddingLeft="14dp"
        android:paddingStart="14dp"
        android:paddingRight="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/update_available"
        android:textColor="@drawable/pill_text"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone" />
</FrameLayout>
