<?xml version="1.0" encoding="utf-8"?>
<!-- A wide control pill, iOS style: dark glass over the blurred desk, near-white on focus. The
     fill is dark, not a faint white wash: these pills now float straight on the blur, so they
     carry their own contrast instead of borrowing it from a panel behind them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F2FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
