<?xml version="1.0" encoding="utf-8"?>
<!--
  The Desktop settings panel.

  Same construction as the Inputs menu upstream: a glass sheet with 6dp of padding and rows that
  carry their own focus pill, so no title bar, no border per row and no close button are needed.
  Rows with a second line of status text are 52dp, plain rows 42dp, which is the rhythm the rest
  of the launcher's menus use. Width and height are set from the content when the popup is built.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_panel"
    android:padding="6dp"
    android:scrollbars="none"
    android:focusable="false"
    android:descendantFocusability="afterDescendants"
    android:elevation="12dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Bing daily: the one option that fetches on its own, so it shows its state as a tick. -->
    <LinearLayout
        android:id="@+id/rowBing"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bing_daily"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/bingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:id="@+id/bingTick"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tick"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Live wallpaper that follows the local weather. On by user choice only. -->
    <LinearLayout
        android:id="@+id/rowWeather"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_weather_clear"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weather_wallpaper"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/weatherStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <!-- Where the weather comes from: IP by default, or a city picked from the built-in list. -->
    <LinearLayout
        android:id="@+id/rowCity"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weather_city"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/cityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- How many days the top bar lays out: today / today+tomorrow / three days. -->
    <LinearLayout
        android:id="@+id/rowForecast"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forecast_days"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/forecastStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Icons per row. The value is always written out underneath, so the current state is
         visible without pressing anything. -->
    <LinearLayout
        android:id="@+id/rowColumns"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/columns_title"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/columnsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Whether the Menu button also opens quick settings while another app is in front. Off by
         default: catching it everywhere takes that button away from the app behind. -->
    <LinearLayout
        android:id="@+id/rowMenuKey"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_key_everywhere"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/menuKeyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <!-- Turn the tweens down for a box whose GPU cannot keep up with them. -->
    <LinearLayout
        android:id="@+id/rowMotion"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reduced_motion"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/motionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pick a picture the user already has on the TV. -->
    <LinearLayout
        android:id="@+id/rowPick"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pick_wallpaper"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Remove the picture and go back to the plain background. -->
    <LinearLayout
        android:id="@+id/rowOff"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wallpaper_off"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- The TV's own settings, in the same panel as the desk's: network, picture, apps, system.
         The desktop settings button is the one place people look for both. -->
    <LinearLayout
        android:id="@+id/rowTvNetwork"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quick_network"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowTvPicture"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quick_picture"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowTvApps"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quick_apps"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowTvSystem"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tv_settings"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- The way back. Uninstalling is all it takes: the stock launcher was never disabled. -->
    <LinearLayout
        android:id="@+id/rowRestore"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:duplicateParentState="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restore_stock"
                android:textColor="@drawable/pill_text"
                android:duplicateParentState="true"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/restoreHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restore_stock_hint"
                android:textColor="@drawable/pill_text_dim"
                android:duplicateParentState="true"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>