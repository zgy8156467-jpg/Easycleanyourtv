<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Control Centre toggles. All are normal permissions. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- Needed on Android 10 to read the Wi-Fi network name; granted over adb at install time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Bing wallpaper, the update check and crash uploads all go through this. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The update APK is handed to the system installer; Android 8+ asks the user to allow it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 6 MIUI refuses writes to external storage without it, and the update APK has to
         land somewhere the system installer can read. Not needed with scoped storage. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- The desktop's own picture grid reads the TV's photos; requested when that grid opens. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Foreground-app lookup for the Home key takeover; the user grants it through the app-ops
         setting (adb shell appops set com.gathin.tvhome GET_USAGE_STATS allow). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- A launcher is the app list: without this Android 11+ only shows us packages we happen to
         name, and vendor file managers and app stores would disappear from the grid. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Android 11+ hides other packages from us unless we name them; the Settings/Wi-Fi fallback
         in MainActivity needs to see Xiaomi's own settings app. -->
    <queries>
        <package android:name="com.xiaomi.mitv.settings" />
        <!-- TCL: Live TV app hosts the source provider, settings is the overlay service, and
             cast lives in MultiScreenInteraction_TV. -->
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.settings" />
        <package android:name="com.tcl.MultiScreenInteraction_TV" />
    </queries>

    <application
        android:name=".TvHomeApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.TvHome"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <!-- HOME plus a normal launcher entry. Without LAUNCHER the desk has no icon anywhere:
                 a fresh U-disk install looks like nothing happened, and after a reinstall (which
                 drops the accessibility binding) there is no way to open it again. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen crash report, shown on the launch after a fatal error. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Crash" />

        <!-- Shown instead of the desk on a phone; see DeviceProfile.isPhone. -->
        <activity
            android:name=".PhoneNoticeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Holo.NoActionBar" />

        <!-- Quick settings, opened by the remote's Settings (选项) button through HomeKeyService.
             Its own task and no history, so the app behind keeps running and Back returns to it. -->
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <!-- The downloaded update APK is cached inside the app; FileProvider is how the system
             installer is allowed to read it (content:// instead of file://). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Outcome of the PackageInstaller session (Remote.install). Invisible on success, which
             replaces this app; on failure it says so instead of the desk going quiet. -->
        <receiver
            android:name=".UpdateResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gathin.tvhome.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Stock PatchWall still boots first on Xiaomi; this brings the desk back on top. Also fires
             when the app is replaced, so a USB update does not leave the TV on PatchWall looking like
             nothing was installed. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.gathin.tvhome/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:enabled="@bool/clock_dream_enabled"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Remote Home button returns to the top (Xiaomi remotes send KEYCODE_ALL_APPS for Home).
             Off by default — only runs if the user enables it in Settings > Accessibility. Declaring
             it requests no permission at install; see HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
    </application>
</manifest>
