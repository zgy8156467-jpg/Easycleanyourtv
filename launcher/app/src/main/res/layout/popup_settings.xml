<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面设置 hub: three entries, each opening its own page. Keeps every page short enough to
     read at sofa distance and to drive with Up/Down only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/liquid_glass_panel"
    android:padding="6dp"
    android:elevation="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:text="@string/launcher_settings"
        android:textColor="#E6111114"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 600" />

    <LinearLayout
        android:id="@+id/hubWallpaper"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wp_group_wallpaper"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hubDesktop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wp_group_desktop"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hubTv"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wp_group_tv"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hubFrame"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/control_row_bg"
        android:paddingLeft="12dp"
        android:paddingStart="12dp"
        android:paddingRight="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/frame_rate_title"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron"
            style="@style/IconTint"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
