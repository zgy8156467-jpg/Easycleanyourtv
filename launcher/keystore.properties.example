# Copy to keystore.properties (gitignored) and fill in your own release key.
# Without this file, `assembleRelease` produces an unsigned APK for local testing only.
storeFile=/absolute/path/to/release.jks
storePassword=change-me
keyAlias=change-me
keyPassword=change-me
# Optional: report token for the feedback backend. Leave empty in public builds.
feedbackToken=
